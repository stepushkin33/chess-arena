# Optional production-bundle smoke test without a real domain or TLS.
:8080 {
	handle /ws {
		reverse_proxy server:3000
	}
	handle /health {
		reverse_proxy server:3000
	}
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle /pieces/* {
		root * /srv
		header Cache-Control "public, max-age=3600"
		file_server
	}
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
