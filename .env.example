# Render: NODE_ENV=production; the public address and port are supplied automatically.
# Optional custom domain for native npm start (do not set for the default Render URL):
# PUBLIC_URL=https://chess.example.com
# ALLOWED_ORIGINS=https://chess.example.com
#
# The values below are only used by the alternative Docker Compose / VPS setup.
DOMAIN=chess.example.com
TLS_EMAIL=admin@example.com
